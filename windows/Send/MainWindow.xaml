<Window x:Class="Send.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Send.Core;assembly=Send.Core"
        xmlns:local="clr-namespace:Send"
        Title="Send" Width="640" Height="800" MinWidth="460" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Transfer / message cards -->
        <DataTemplate DataType="{x:Type core:Xfer}">
            <Border Margin="0,0,0,10" Padding="14" CornerRadius="12" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Elevated}"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Arrow" Data="{StaticResource IcDown}" Stroke="{StaticResource Ink}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SansMedium}" FontSize="15"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MonoText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       x:Name="MetaText"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ShowBtn" Style="{StaticResource SmallGhostBtn}" Content="Show" Click="OnShowFile"
                                    Visibility="Collapsed" Margin="0,0,8,0"/>
                            <Border x:Name="Pill" Visibility="Collapsed" CornerRadius="12" Padding="10,4" Background="{StaticResource Elevated}"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PillText" Text="Done" FontFamily="{StaticResource Sans}" FontSize="12" Foreground="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="CancelBtn" Style="{StaticResource IconBtn}" Click="OnCancel" ToolTip="Cancel">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IcX}" Stroke="{StaticResource Mute}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="Bar" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource HairProgress}" Value="{Binding Progress, Mode=OneWay}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOut}" Value="True"><Setter TargetName="Arrow" Property="Data" Value="{StaticResource IcUp}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource Red}"/>
                    <Setter TargetName="PillText" Property="Text" Value="Failed"/>
                    <Setter TargetName="MetaText" Property="Foreground" Value="{StaticResource Red}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter TargetName="PillDot" Property="Fill" Value="{StaticResource Stone}"/>
                    <Setter TargetName="PillText" Property="Text" Value="Stopped"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanShow}" Value="True"><Setter TargetName="ShowBtn" Property="Visibility" Value="Visible"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TextItem}">
            <Border Margin="0,0,0,10" Padding="14" CornerRadius="12" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top" Background="{StaticResource Elevated}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Arrow" Data="{StaticResource IcDown}" Stroke="{StaticResource Ink}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <TextBlock Text="{Binding Who}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding Text}" Style="{StaticResource BodySmText}" Foreground="{StaticResource Body}"
                                   TextTrimming="CharacterEllipsis" MaxHeight="100" IsHitTestVisible="True"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SmallGhostBtn}" Content="Copy" Click="OnCopyText" VerticalAlignment="Top"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Out}" Value="True"><Setter TargetName="Arrow" Property="Data" Value="{StaticResource IcUp}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- one soft radial wash at the top; its colour tells the state -->
        <Rectangle IsHitTestVisible="False" VerticalAlignment="Top" Height="560">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.85" RadiusY="0.95">
                    <GradientStop x:Name="GlowA" Color="#570075FF" Offset="0"/>
                    <GradientStop x:Name="GlowB" Color="#000075FF" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- top bar -->
            <Grid Grid.Row="0" Margin="26,0,10,0">
                <TextBlock Text="send" FontFamily="{StaticResource Serif}" FontSize="32" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" CornerRadius="14" Padding="11,5" Margin="0,0,6,0" Background="{StaticResource Elevated}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Blue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Searching" FontFamily="{StaticResource Sans}" FontSize="12.5" Foreground="{StaticResource Body}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconBtn}" Click="OnSettings" ToolTip="Settings" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IcGear}" Stroke="{StaticResource Mute}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="OnMinimize" ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IcMin}" Stroke="{StaticResource Mute}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="OnClose" ToolTip="Close to tray" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IcX}" Stroke="{StaticResource Mute}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel MaxWidth="600" Margin="26,6,26,36">

                    <!-- hero -->
                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource Serif}" FontSize="56" LineHeight="54"
                               LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <TextBlock x:Name="HeroSub" Style="{StaticResource BodyText}" Margin="0,14,0,0"/>

                    <!-- drop zone -->
                    <Border x:Name="DropCard" Margin="0,26,0,0" Padding="24" CornerRadius="12" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="DropTitle" Text="Drop files or folders here" FontFamily="{StaticResource Serif}" FontSize="30"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DropSub" Style="{StaticResource BodySmText}" Margin="0,6,0,0"
                                       Text="They go straight to your phone over your own network."/>
                            <WrapPanel Margin="0,20,0,0">
                                <Button x:Name="BtnFiles" Style="{StaticResource PrimaryBtn}" Content="Choose files" Click="OnChooseFiles" Margin="0,0,8,8"/>
                                <Button x:Name="BtnFolder" Style="{StaticResource GhostBtn}" Content="Choose folder" Click="OnChooseFolder" Margin="0,0,8,8"/>
                                <Button x:Name="BtnText" Style="{StaticResource GhostBtn}" Content="Send text" Click="OnSendText" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- code window -->
                    <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="12" Background="{StaticResource Deep}"
                            BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Red}" Margin="0,0,6,0"/>
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Yellow}" Margin="0,0,6,0"/>
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Green}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="pc" Style="{StaticResource MonoText}" Foreground="{StaticResource Ash}" Margin="0,2"/>
                                <TextBlock x:Name="KvPc" Grid.Column="1" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="phone" Style="{StaticResource MonoText}" Foreground="{StaticResource Ash}" Margin="0,2"/>
                                <TextBlock x:Name="KvPhone" Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="saves to" Style="{StaticResource MonoText}" Foreground="{StaticResource Ash}" Margin="0,2"/>
                                <TextBlock x:Name="KvSave" Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="3" Text="security" Style="{StaticResource MonoText}" Foreground="{StaticResource Ash}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="TLS 1.3 · pinned key" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink}" Margin="0,2"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SmallGhostBtn}" Content="Open folder" Click="OnOpenSaveFolder" Margin="0,0,8,0"/>
                                <Button x:Name="BtnRetry" Style="{StaticResource SmallGhostBtn}" Content="Look again" Click="OnRetry"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- activity -->
                    <Grid Margin="0,26,0,12">
                        <TextBlock Text="Activity" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClear" Style="{StaticResource SmallGhostBtn}" Content="Clear" Click="OnClear" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </Grid>
                    <Border x:Name="EmptyCard" Padding="22" CornerRadius="12" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Nothing yet." FontFamily="{StaticResource Serif}" FontStyle="Italic" FontSize="30" Foreground="{StaticResource Ink}"/>
                            <TextBlock Style="{StaticResource BodySmText}" Margin="0,6,0,0"
                                       Text="Files you send or receive show up here. On your phone, share anything to Send, or pick files in the app."/>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="Items" Focusable="False"/>

                    <TextBlock x:Name="MsgHead" Text="Messages" Style="{StaticResource Heading}" Margin="0,18,0,12" Visibility="Collapsed"/>
                    <ItemsControl x:Name="Texts" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= overlays ================= -->

        <!-- pairing -->
        <Grid x:Name="PairOverlay" Visibility="Collapsed" Background="#B3000000">
            <Border MaxWidth="440" Margin="24" VerticalAlignment="Center" Padding="26" CornerRadius="16" Background="{StaticResource Elevated}"
                    BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="PairTitle" FontFamily="{StaticResource Serif}" FontSize="34" Foreground="{StaticResource Ink}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Border Margin="0,20,0,0" Padding="0,18" CornerRadius="12" Background="{StaticResource Deep}"
                            BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1">
                        <TextBlock x:Name="PairCodeText" FontFamily="{StaticResource Mono}" FontSize="44" Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Style="{StaticResource BodySmText}" TextAlignment="Center" Margin="0,16,0,0"
                               Text="Look at your phone: it shows the same code. If they match, tap Allow there. First time only."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Ellipse x:Name="PairDot" Width="8" Height="8" Fill="{StaticResource Yellow}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Waiting for your phone" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- text -->
        <Grid x:Name="TextOverlay" Visibility="Collapsed" Background="#B3000000" MouseDown="OnScrimDown">
            <Border MaxWidth="480" Margin="24" VerticalAlignment="Center" Padding="22" CornerRadius="16" Background="{StaticResource Elevated}"
                    BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1" MouseDown="OnCardDown">
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource Serif}" FontSize="32" Foreground="{StaticResource Ink}">
                        <Run Text="Send "/><Run Text="text" FontStyle="Italic"/>
                    </TextBlock>
                    <TextBox x:Name="TextBoxMsg" Style="{StaticResource Field}" Margin="0,14,0,0" MinHeight="110" MaxHeight="220"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostBtn}" Content="Paste" Click="OnPasteText" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GhostBtn}" Content="Cancel" Click="OnCloseOverlays" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryBtn}" Content="Send" Click="OnTextSend"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- settings -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#E6000000" MouseDown="OnScrimDown">
            <Border MaxWidth="520" Margin="24" VerticalAlignment="Center" Padding="24" CornerRadius="16" Background="{StaticResource Elevated}"
                    BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1" MouseDown="OnCardDown">
                <StackPanel>
                    <TextBlock Text="Settings" FontFamily="{StaticResource Serif}" FontStyle="Italic" FontSize="34" Foreground="{StaticResource Ink}"/>

                    <TextBlock Text="This PC's name" Style="{StaticResource CaptionText}" Margin="0,18,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="40"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Save" Click="OnSaveName" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Save received files to" Style="{StaticResource CaptionText}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SaveBox" Style="{StaticResource Field}" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Change" Click="OnChangeSave" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Paired phones" Style="{StaticResource CaptionText}" Margin="0,16,0,6"/>
                    <StackPanel x:Name="PhonesPanel"/>

                    <TextBlock Text="Phone not found? Add its address" Style="{StaticResource CaptionText}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="IpBox" Style="{StaticResource Field}" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Add" Click="OnAddIp" Margin="8,0,0,0"/>
                    </Grid>

                    <Button x:Name="AutoStartBtn" Style="{StaticResource GhostBtn}" Click="OnToggleAutoStart" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Margin="0,16,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource GhostBtn}" Content="Quit Send" Click="OnQuit" Margin="0,0,8,0" Foreground="{StaticResource Red}"/>
                        <Button Style="{StaticResource PrimaryBtn}" Content="Done" Click="OnCloseOverlays"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
