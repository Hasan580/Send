<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tokens: true black canvas, translucent-white hairlines, no shadows. -->
    <SolidColorBrush x:Key="Canvas" Color="#000000"/>
    <SolidColorBrush x:Key="Card" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="Elevated" Color="#101012"/>
    <SolidColorBrush x:Key="Deep" Color="#06060A"/>
    <SolidColorBrush x:Key="Ink" Color="#FCFDFF"/>
    <SolidColorBrush x:Key="Body" Color="#DBFCFDFF"/>
    <SolidColorBrush x:Key="Mute" Color="#A1A4A5"/>
    <SolidColorBrush x:Key="Ash" Color="#888E90"/>
    <SolidColorBrush x:Key="Stone" Color="#464A4D"/>
    <SolidColorBrush x:Key="Hairline" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="HairlineStrong" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Green" Color="#11FF99"/>
    <SolidColorBrush x:Key="Red" Color="#FF2047"/>
    <SolidColorBrush x:Key="Yellow" Color="#FFC53D"/>
    <SolidColorBrush x:Key="Blue" Color="#3B9EFF"/>
    <SolidColorBrush x:Key="Orange" Color="#FF801F"/>

    <!-- Domaine Display stand-in: Instrument Serif. Geist replaces ABC Favorit / Inter. -->
    <FontFamily x:Key="Serif">pack://application:,,,/Fonts/#Instrument Serif</FontFamily>
    <FontFamily x:Key="Sans">pack://application:,,,/Fonts/#Send Sans</FontFamily>
    <FontFamily x:Key="SansMedium">pack://application:,,,/Fonts/#Send Sans Medium</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#Send Mono</FontFamily>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Mute}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="24"/>
    </Style>
    <Style x:Key="BodySmText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansMedium}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Mute}"/>
    </Style>

    <!-- Buttons: the white pill is the one bright surface; ghost is elevated with a hairline. -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Canvas}"/>
        <Setter Property="FontFamily" Value="{StaticResource SansMedium}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{StaticResource Ink}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F7FE"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{StaticResource Elevated}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#16161A"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallGhostBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="19">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field: card surface, hairline border; focus brightens the border to ink. -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="#55FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{StaticResource Card}" BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2px hairline progress -->
    <Style x:Key="HairProgress" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Height" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{StaticResource HairlineStrong}" CornerRadius="1"/>
                        <Border x:Name="PART_Indicator" Background="{StaticResource Ink}" CornerRadius="1" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin dark scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="10">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border Margin="3,0" CornerRadius="2" Background="#30FFFFFF"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stroked icon geometries (24x24) -->
    <Geometry x:Key="IcUp">M12,19 L12,5 M6,11 L12,5 L18,11</Geometry>
    <Geometry x:Key="IcDown">M12,5 L12,19 M6,13 L12,19 L18,13</Geometry>
    <Geometry x:Key="IcX">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IcCheck">M5,12.5 L10,17.5 L19,7</Geometry>
    <Geometry x:Key="IcGear">M12,8.8 A3.2,3.2 0 1 1 11.99,8.8 Z M12,3 L12,5.4 M12,18.6 L12,21 M3,12 L5.4,12 M18.6,12 L21,12 M5.6,5.6 L7.3,7.3 M16.7,16.7 L18.4,18.4 M5.6,18.4 L7.3,16.7 M16.7,7.3 L18.4,5.6</Geometry>
    <Geometry x:Key="IcFolder">M3.5,7.5 L3.5,18 Q3.5,19 4.5,19 L19.5,19 Q20.5,19 20.5,18 L20.5,9.5 Q20.5,8.5 19.5,8.5 L11,8.5 L9,6 L4.5,6 Q3.5,6 3.5,7 Z</Geometry>
    <Geometry x:Key="IcFile">M7,3.5 L14,3.5 L18.5,8 L18.5,19.5 Q18.5,20.5 17.5,20.5 L7,20.5 Q6,20.5 6,19.5 L6,4.5 Q6,3.5 7,3.5 M14,3.5 L14,8 L18.5,8</Geometry>
    <Geometry x:Key="IcText">M5,7 L19,7 M12,7 L12,19 M9,19 L15,19</Geometry>
    <Geometry x:Key="IcCopy">M9,9 L19,9 L19,19 L9,19 Z M15,9 L15,5.5 L5.5,5.5 L5.5,15 L9,15</Geometry>
    <Geometry x:Key="IcMin">M6,12 L18,12</Geometry>

</ResourceDictionary>
